# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Robinhood Chain mainnet = 4663, testnet = 46630
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# ---------------------------------------------------------------------------
# Wallet
# ---------------------------------------------------------------------------
# The buyback & burn wallet's private key. This wallet receives USDG rewards
# AND executes the swap + burn. Keep this out of source control.
# Strongly consider a KMS / hardware signer / relayer for production instead
# of a raw env-var private key (see README "Key security" section).
PRIVATE_KEY=0x...

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168          # USDG token contract on Robinhood Chain
TOKEN_ADDRESS=0x375251Ef3DA137BFC1c6468d42894468596e5168         # Your token to buy back and burn
TOKEN_DECIMALS=18

FEE=0
TICK_SPACING=1
HOOK_ADDR=0xD7C08B7A96f1E19072913e28E6509b9c704Ec0CC

ETH_USDG_FEE=8388608
ETH_USDG_TICK_SPACING=10
ETH_USDG_HOOK_ADDR=0x06a889870C8f83640D6816319f72e2aA579b6080

USE_INIT_WALLET_BALANCE=false
BUNR_WALLET_INIT_BALANCE=2000000
# Uniswap v4

UNIVERSAL_ROUTER_ADDRESS=0x8876789976decbfcbbbe364623c63652db8c0904
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# ---------------------------------------------------------------------------
# Uniswap v2 on Robinhood Chain
# ---------------------------------------------------------------------------
# Fill this in from the official Uniswap V2 Router deployment address on
# Robinhood Chain (check the Uniswap docs / Blockscout explorer for the chain).
UNISWAP_V2_ROUTER_ADDRESS=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
# How long a swap tx has to be mined before it reverts (seconds)
SWAP_DEADLINE_SECONDS=300

# ---------------------------------------------------------------------------
# Burn behavior
# ---------------------------------------------------------------------------
# "dead" sends bought tokens to 0x000000000000000000000000000000000000dEaD
# "burnFunction" calls TOKEN.burn(amount) - only use if your token implements it
BURN_METHOD=dead
BURN_ADDRESS=0x000000000000000000000000000000000000dEaD

# ---------------------------------------------------------------------------
# Strategy / safety
# ---------------------------------------------------------------------------
# Don't swap if USDG balance is below this (in whole USDG units, e.g. "10")
MIN_USDG_BALANCE=10
# Max acceptable slippage in basis points (100 = 1%)
MAX_SLIPPAGE_BPS=500
# Interval between buyback cycles, in minutes
INTERVAL_MINUTES=5
# If true, logs what WOULD happen without sending transactions
DRY_RUN=true

# ---------------------------------------------------------------------------
# Reserve protection (critical if this wallet also holds tokens that must
# NEVER be burnt, e.g. a permanent 2% team/treasury reserve)
# ---------------------------------------------------------------------------
# The wallet's TOKEN balance will never be allowed to drop below this,
# regardless of what a swap/balance computation says. In whole token units
# (e.g. "20000000" for 20M tokens = 2% of a 1B supply).
RESERVE_TOKEN_BALANCE=20000000
